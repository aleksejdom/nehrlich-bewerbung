---
import LandingPageLayout from "../layouts/LandingPageLayout.astro";
const steps = [
  "Standort",
  "Ausbildung",
  "Erfahrung", 
  "Erreichbarkeit",
  "Kontakt"
];
---

<LandingPageLayout> 
  <div class="flex flex-col items-center justify-start bg-zinc-100 w-full md:p-8 p-2 ">
    <div class="w-full flex flex-col md:p-15 p-6 bg-gray-200 gap-2 justify-items-center md:justify-items-start items-center md:h-full" >
      <div class="max-w-[800px]">
        <h1 class="text-2xl md:text-3xl font-semibold leading-7 mb-2">Einfach in 5-Schritten bewerben</h1>
        <a href="mailto:info@nehrlich.eu"><p class="text-md flex gap-2 items-center">oder schicke uns deine Bewerbung per E-Mail an: info@nehrlich.eu</p></a> 
        <form id="applyForm" action="/api/apply" method="POST" class="bg-white rounded-2xl shadow p-6 sm:p-10 w-fit mt-12">
          
          <!-- Progress -->
          <div class="mb-8">
            <div class="flex justify-between items-center mb-2">
              <div id="progressLabel" class="text-sm font-medium text-gray-600">0%</div>
              <div class="text-sm text-gray-500">Schritt <span id="stepIndex">1</span> / {steps.length}</div>
            </div>
            <div class="h-2 bg-gray-200 rounded">
              <div id="progressBar" class="h-2 bg-green-600 rounded w-0"></div>
            </div>
          </div>

          <!-- 1) Standort -->
          <section data-step="1" class="step">
            <h1 class="text-2xl sm:text-3xl font-semibold text-center mb-8">Für welchen Nehrlich Standort möchtest du dich bewerben?</h1>
            <div class="space-y-4">
              <label class="block">
                <input type="radio" name="standort" value="Tübingen" class="peer hidden" required>
                <div class="rounded-xl border border-gray-200 bg-gray-50 px-5 py-4 peer-checked:border-green-600 peer-checked:bg-green-50 cursor-pointer">Tübingen</div>
              </label>
              <label class="block">
                <input type="radio" name="standort" value="Rottenburg" class="peer hidden" required>
                <div class="rounded-xl border border-gray-200 bg-gray-50 px-5 py-4 peer-checked:border-green-600 peer-checked:bg-green-50 cursor-pointer">Rottenburg</div>
              </label>
            </div>
          </section>

          <!-- 2) Ausbildung -->
          <section data-step="2" class="step hidden">
            <h2 class="text-2xl sm:text-3xl font-semibold text-center mb-8">Hast du eine Ausbildung/Studium zum Ergotherapeut (m/w/d) oder schließt es bald ab?</h2>
            <div class="grid grid-cols-2 gap-4">
              <label class="block">
                <input type="radio" name="ausbildung" value="Ja" class="peer hidden" required>
                <div class="rounded-xl border border-gray-200 bg-gray-50 p-6 text-center peer-checked:border-green-600 peer-checked:bg-green-50 cursor-pointer flex flex-col items-center h-full">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-14">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  <p class="text-2xl">Ja</p>
                </div>
              </label>
              <label class="block">
                <input type="radio" name="ausbildung" value="Nein" class="peer hidden" required>
                <div class="rounded-xl border border-gray-200 bg-gray-50 p-6 text-center peer-checked:border-green-600 peer-checked:bg-green-50 cursor-pointer flex flex-col items-center h-full">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 ">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
                  </svg> 
                  <p class="text-2xl">Nein</p>
                </div>
              </label>
            </div>
          </section>

          <!-- 3) Erfahrung -->
          <section data-step="3" class="step hidden">
            <h2 class="text-2xl sm:text-3xl font-semibold text-center mb-8">Hast du bereits Berufserfahrung gesammelt?</h2>
            <div class="space-y-4">
              {["Keine Erfahrung","1-2 Jahre","3-5 Jahre","Über 5 Jahre"].map(opt => (
                <label class="block">
                  <input type="radio" name="erfahrung" value={opt} class="peer hidden" required>
                  <div class="rounded-xl border border-gray-200 bg-gray-50 px-5 py-4 peer-checked:border-green-600 peer-checked:bg-green-50 cursor-pointer">{opt}</div>
                </label>
              ))}
            </div>

            <!-- NEU: Abschlussfrage (nur sichtbar bei "Keine Erfahrung") -->
            <div id="abschlussWrap" class="mt-6 hidden">
              <label class="block">
                <span class="block text-sm font-medium mb-1">Wann schließt du deine Ausbildung/Studium ab? *</span>
                <input
                  type="month"
                  name="abschluss"
                  placeholder="YYYY-MM"
                  class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600"
                />
                <p class="text-xs text-gray-500 mt-1">Wenn das Datum noch nicht exakt feststeht, gib bitte den geplanten Monat an.</p>
              </label>
            </div>
          </section> 

          <!-- 4) Erreichbarkeit -->
          <section data-step="4" class="step hidden">
            <h2 class="text-2xl sm:text-3xl font-semibold text-center mb-2">Wann bist du am besten erreichbar?</h2>
            <p class="text-center text-gray-500 mb-6">Du kannst gerne mehrere Zeiten auswählen</p>
            <div class="space-y-4">
              {[
                ["Morgens (8–12 Uhr)","morgens"],
                ["Tagsüber (12–17 Uhr)","tagsueber"],
                ["Abends (17–20 Uhr)","abends"],
                ["Ganztägig","ganztags"]
              ].map(([label,val]) => (
                <label class="flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 px-5 py-4 cursor-pointer">
                  <input type="checkbox" name="erreichbarkeit" value={val} class="size-5" />
                  <span class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                    </svg>
                    {label}
                  </span>
                </label>
              ))}
            </div>
          </section>

          <!-- 5) Kontakt -->
          <section data-step="5" class="step hidden">
            <h2 class="text-2xl sm:text-3xl font-semibold text-center mb-2">Wie können wir dich erreichen?</h2>
            <p class="text-center text-gray-500 mb-6">Erhalte dein unverbindliches Jobangebot.</p>
            <div class="grid gap-4">
              <label class="block">
                <span class="block text-sm font-medium mb-1">Name *</span>
                <input name="name" required placeholder="Vor- Nachname" class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600" />
              </label>
              <label class="block">
                <span class="block text-sm font-medium mb-1">E-Mail *</span>
                <input type="email" name="email" required placeholder="E-Mail Adresse" class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600" />
              </label>
              <label class="block">
                <span class="block text-sm font-medium mb-1">Telefon *</span>
                <input type="tel" name="telefon" required placeholder="+49" class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-green-600" />
              </label>
            </div>
          </section>

          <!-- Honeypot -->
          <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

          <!-- Nav Buttons -->
          <div class="mt-10 flex md:flex-row flex-col md:justify-between items-stretch gap-2">
            <button type="button" id="prevBtn" class="rounded-xl bg-gray-200 text-gray-700 px-5 py-3 disabled:opacity-50 cursor-pointer flex items-center md:justify-center gap-1 h-full min-h-[45px]" disabled>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4" >
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
              <span class="h-3 leading-2 m-0 p-0">zurück</span>
            </button>
            <button type="button" id="nextBtn" class="rounded-xl bg-green-700 text-white font-semibold px-6 py-3 cursor-pointer text-left">Weiter zum nächsten Schritt</button>
            <button type="submit" id="submitBtn" class="hidden rounded-xl bg-green-700 text-white font-semibold px-6 py-3 cursor-pointer">Jetzt bewerben</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</LandingPageLayout>

<script is:inline>
  const stepsEls = Array.from(document.querySelectorAll('.step'));
  const slugs = stepsEls.map(s => s.dataset.stepSlug || String(s.dataset.step || ''));
  const nextBtn = document.getElementById('nextBtn');
  const prevBtn = document.getElementById('prevBtn');
  const submitBtn = document.getElementById('submitBtn');
  const bar = document.getElementById('progressBar');
  const label = document.getElementById('progressLabel');
  const stepIndexEl = document.getElementById('stepIndex');
  let i = 0;

  function slugToIndexFromUrl() {
    const params = new URLSearchParams(location.search);
    const slug = params.get('page');
    const idx = slugs.indexOf(slug);
    return idx >= 0 ? idx : 0;
  }

  function setUrlForIndex(idx, push = true) {
    const slug = slugs[idx] ?? String(idx + 1);
    const url = `${location.pathname}?page=${slug}`;
    if (push) {
      history.pushState(null, '', url);
    } else {
      history.replaceState(null, '', url);
    }
  }

  function showIndex(idx) {
    i = Math.max(0, Math.min(idx, stepsEls.length - 1));
    stepsEls.forEach((s, k) => s.classList.toggle('hidden', k !== i));
    prevBtn.disabled = i === 0;
    const percent = Math.round((i / (stepsEls.length - 1)) * 100);
    bar.style.width = percent + '%';
    label.textContent = percent + '%';
    stepIndexEl.textContent = String(i + 1);
    const last = i === stepsEls.length - 1;
    nextBtn.classList.toggle('hidden', last);
    submitBtn.classList.toggle('hidden', !last);
  }

  function validateCurrent() {
    const cur = stepsEls[i];
    const required = cur.querySelectorAll('[required]');
    for (const el of required) {
      if (el.type === 'radio') {
        const anyChecked = cur.querySelector(`input[name="${el.name}"]:checked`);
        if (!anyChecked) return false;
      } else if (!el.value?.trim()) {
        return false;
      }
    }
    return true;
  }

  // NEU: Abfanglogik für Step 2 "Ausbildung"
  const ausbildungInputs = document.querySelectorAll('input[name="ausbildung"]');
  ausbildungInputs.forEach((el) => {
    el.addEventListener('change', (e) => {
      const val = e.target.value;
      if (val === 'Nein') {
        window.location.assign('/sorry');
      } else if (val === 'Ja') {
        const next = Math.min(i + 1, stepsEls.length - 1);
        if (next !== i) {
          showIndex(next);
          setUrlForIndex(next, true);
        }
      }
    });
  });

  // NEU: Sichtbarkeit/Required für Abschluss bei "Keine Erfahrung"
  const erfahrungInputs = document.querySelectorAll('input[name="erfahrung"]');
  const abschlussWrap = document.getElementById('abschlussWrap');
  const abschlussInput = document.querySelector('input[name="abschluss"]');

  function toggleAbschlussByErfahrung(value) {
    const needsAbschluss = value === 'Keine Erfahrung';
    abschlussWrap.classList.toggle('hidden', !needsAbschluss);
    if (needsAbschluss) {
      abschlussInput.setAttribute('required', '');
    } else {
      abschlussInput.removeAttribute('required');
      abschlussInput.value = '';
    }
  }

  erfahrungInputs.forEach((el) => {
    el.addEventListener('change', (e) => {
      toggleAbschlussByErfahrung(e.target.value);
    });
  });

  // Initial
  i = slugToIndexFromUrl();
  setUrlForIndex(i, false);
  showIndex(i);

  // Falls per History/Back oder vorbefüllt:
  const preCheckedErf = document.querySelector('input[name="erfahrung"]:checked');
  if (preCheckedErf) toggleAbschlussByErfahrung(preCheckedErf.value);

  nextBtn.addEventListener('click', () => {
    if (!validateCurrent()) {
      alert('Bitte fülle den aktuellen Schritt aus.');
      return;
    }
    const next = Math.min(i + 1, stepsEls.length - 1);
    if (next !== i) {
      showIndex(next);
      setUrlForIndex(next, true);
    }
  });

  prevBtn.addEventListener('click', () => {
    const prev = Math.max(i - 1, 0);
    if (prev !== i) {
      showIndex(prev);
      setUrlForIndex(prev, true);
    }
  });

  window.addEventListener('popstate', () => {
    const idx = slugToIndexFromUrl();
    if (idx !== i) showIndex(idx);
  });
</script>
