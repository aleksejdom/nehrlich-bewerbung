---
import LandingPageLayout from "../layouts/LandingPageLayout.astro";
import Header from "../components/Header.astro";
import placeholder from "../assets/1440x640.png";
import kununuProfile from "../assets/kununu-profile-de.svg";
import kununuRaiting from "../assets/self-service-color.svg";
import BringstDuMit from "../components/BringstDuMit.astro";
import Button from "../components/Button.astro";
import Slider from "../components/Slider.astro";
import Bewerbung from "../components/Bewerbung.astro";	
import Vorteile from "../components/Vorteile.astro";
import Footer from "../components/Footer.astro";	
import CallToAction from "../components/CallToAction.astro";
import Standorte from "../components/Standorte.astro";

const standorte = {
	standorte: [
		{
			name: "Tübingen", 
		},
		{
			name: "Rottenburg am Neckar", 
		},
	],
};

const benefits = [
	"4-Tage-Woche, 36 Std., volles Gehalt", 
	"Attraktives Gehalt mit Sonderzahlungen", 
	"Vielfältige Tätigkeitsbereiche"
];

const title="Wir suchen dich als Ergotherapeut (m/w/d)";
const overline="Lust auf echte Work-Life-Balance? Bei uns bist du genau richtig!";
const ctaLink = "/bewerbung";
const ctaText = "Jetzt bewerben - in 1 Minute!";
const info = "Voll-/Teilzeit, unbefristet, ab sofort";
const image = placeholder;
---

<LandingPageLayout>
	<Header
			standorte={standorte}
			overline={overline}
			title={title}
			benefits={benefits}  
			ctaLink={ctaLink}
			ctaText={ctaText}
			info={info}
			image={image}
	></Header>
	<section class="about">
		<div class="container">
			<div class="flex md:flex-row flex-col gap-10 md:gap-0">
					
				<div class="flex flex-col gap-5 w-full md:w-1/2">
					<h3 class="max-w-[350px] leading-12">Top-Arbeitgeber bei Kununu</h3>
					<div class="flex flex-col gap-5 md:mt-5 mt-1"> 
						<img src={kununuRaiting.src} alt="Kununu Raiting" class="w-50">
						<p class="text-xl max-w-[450px]">
							Praxis Nehrlich hat sich als Top-Arbeitgeber auf Kununu etabliert, eine Auszeichnung, die nur den besten 5% der bewerteten Arbeitgeber zuteilwird.
						</p>
					</div>
				</div>

				<Slider />
		</div>
	</section>
	<Vorteile />
	<CallToAction ctaLink={ctaLink} ctaText={ctaText} />
	<BringstDuMit />
	<Bewerbung /> 
	<Standorte />
	<Footer ctaLink={ctaLink} ctaText={ctaText} />
</LandingPageLayout>