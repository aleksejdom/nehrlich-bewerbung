---
import Button from "./Button.astro";
import headerImage from "../assets/header-person.jpg";
import logo from "../assets/logo-n.svg";
const { title, overline, benefits, ctaLink, ctaText, standorte, info } = Astro.props;
---

<div class="header bg-zinc-100 flex flex-col md:flex-row">
  <!-- linke Spalte -->
  <div class="col w-full md:w-3/5 sm:p-20 p-10 flex flex-col justify-center items-center">
    <div class="max-w-[650px] w-full">
      <div class="standorte flex flex-wrap gap-2 mb-4">
        {standorte.standorte.map((standort:any) => (
          <div class="standort flex flex-row items-center justify-center gap-1 py-1 px-3 bg-zinc-800 rounded-md text-white" key={standort.name}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 w-4">
            <path fill-rule="evenodd" d="m11.54 22.351.07.04.028.016a.76.76 0 0 0 .723 0l.028-.015.071-.041a16.975 16.975 0 0 0 1.144-.742 19.58 19.58 0 0 0 2.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 0 0-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 0 0 2.682 2.282 16.975 16.975 0 0 0 1.145.742ZM12 13.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd" />
          </svg> 
            <p class="text-sm">{standort.name}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-2 sm:gap-4 mt-8">
        <h1 class="text-4xl md:text-6xl font-semibold md:leading-15 leading-10 mb-2 ">{title}</h1>
        <p class="text-sm text-gray-500 leading-5">{info}</p>
        <p class="text-zinc-700 md:text-3xl text-l md:max-w-[500px] max-w-[250px] font-semibold md:leading-8 leading-5 mt-4">{overline}</p>

        <div class="benefits flex flex-col gap-2 p-5 mt-4 bg-white rounded-lg shadow w-fit">
          {benefits.map((item:any) => ( 
            <div class="text-sm border-b border-full border-gray-200 p-1 pt-0 last:border-none last:pb-0 flex gap-2" key={item}>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
              </svg>
              {item}
            </div>
          ))}
        </div>

        <Button
          btn_title={ctaText}
          btn_link={ctaLink}
        ></Button>
      </div>
    </div>
  </div>

  <!-- rechte Spalte -->
  <div class="col w-full md:w-2/5 relative">
    <img
      src={headerImage.src}
      alt="Header Image"
      class="welcome w-full h-56 sm:h-72 md:h-full object-cover"
    />
    <div class="logo absolute bottom-[15px] left-[25px] w-[150px] h-[60px]">
      <img
        src={logo.src}
        alt="Logo"
        class="w-full h-full"
      />
    </div>
  </div>
</div>

<style>
  .header { text-align: left; }
  .header img.welcome {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .header .logo img {
    width: 100%;
    height: 100%; 
  }
</style>
