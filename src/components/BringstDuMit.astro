---
import buero from "../assets/working.jpg";
---

<section class="bg-white w-full">
  <div class="container">
    <div class="w-full flex md:gap-20 gap-10 flex-col md:flex-row">
      <div class="w-full md:w-1/2">
        <img src={buero.src} alt="Kununu Profil" class="w-full shadow-sm rounded-2xl object-cover h-full max-h-[350px] aspect-ratio-16/9" loading="lazy" />	
      </div>
      <div class="w-full md:w-1/2">
        <h3>Das bringst du mit</h3>
        <div class="flex flex-col gap-2 mt-6 bh-white rounded-2xl">
          <div class="w-fit p-1 text-xl flex gap-2 ">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 max-w-[24px] min-w-[24px] mt-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            Abgeschlossene Ausbildung/Studium als Ergotherapeut*in (oder schließt es bald ab)
          </div>
          <div class="w-fit p-1 text-xl flex gap-2 ">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 max-w-[24px] min-w-[24px] mt-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg> 
            Herzlicher Umgang mit Patient*innen
          </div>
          <div class="w-fit p-1 text-xl flex gap-2 ">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 max-w-[24px] min-w-[24px] mt-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg> 
            Eigenverantwortliches Arbeiten & Teamfähigkeit
          </div> 
        </div>
      </div>
    </div> 
  </div>
</section>

